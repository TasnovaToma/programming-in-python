# Exercise 1: Campus Resource Tracker

resources = [
    [101, "Laptop", "Electronics", 8],
    [102, "Projector", "Electronics", 0],
    [103, "Whiteboard", "Classroom", 5],
    [104, "Microphone", "Audio", 3],
    [105, "Camera", "Electronics", 2]
]

# Task 1: Display all resources
def display_resources(resources):
    if not resources:
        print("No resources available.")
        return

    for resource in resources:
        print(
            "ID:", resource[0],
            "| Name:", resource[1],
            "| Category:", resource[2],
            "| Quantity:", resource[3]
        )


# Task 2: Search resources by category
def search_by_category(resources, category):
    found = False

    for resource in resources:
        if resource[2].lower() == category.lower():
            print(resource)
            found = True

    if not found:
        print("No resources found in this category.")


# Task 3: Find unavailable resources
def find_unavailable(resources):
    found = False

    for resource in resources:
        if resource[3] == 0:
            print(resource)
            found = True

    if not found:
        print("No unavailable resources.")


print("EXERCISE 1: CAMPUS RESOURCE TRACKER")

print("\nAll Resources:")
display_resources(resources)

print("\nElectronics Resources:")
search_by_category(resources, "Electronics")

print("\nUnavailable Resources:")
find_unavailable(resources)


# Exercise 2: Student Marks Investigator

students = [
    [201, "Amina", [78, 85, 90]],
    [202, "Rahim", [65, 70, 68]],
    [203, "Nadia", [92, 88, 95]],
    [204, "Hasan", [55, 60, 65]],
    [205, "Tania", [80, 80, 80]]
]


# Task 1: Calculate average marks
def calculate_average(marks):
    if not marks:
        return None

    for mark in marks:
        if not isinstance(mark, (int, float)) or mark < 0 or mark > 100:
            return None

    return sum(marks) / len(marks)


# Task 2: Classify performance
def classify_performance(average):
    if average is None:
        return "Invalid or Missing Marks"
    elif average >= 80:
        return "Excellent"
    elif average >= 70:
        return "Good"
    elif average >= 60:
        return "Satisfactory"
    else:
        return "Needs Improvement"


# Task 3: Display student report
def display_report(students):
    if not students:
        print("No student records available.")
        return

    for student in students:
        if len(student) != 3:
            print("Invalid student record:", student)
            continue

        student_id, name, marks = student
        average = calculate_average(marks)

        if average is None:
            print(
                "ID:", student_id,
                "| Name:", name,
                "| Average: N/A",
                "| Performance:", classify_performance(None)
            )
        else:
            print(
                "ID:", student_id,
                "| Name:", name,
                "| Average:", round(average, 2),
                "| Performance:", classify_performance(average)
            )


print("\nEXERCISE 2: STUDENT MARKS INVESTIGATOR")

display_report(students)


